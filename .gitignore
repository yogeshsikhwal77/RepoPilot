# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
*.pem
secrets.json

# ==========================================
# Python (API, Agents, Orchestrator)
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/
.env_python/

# Testing & Type Checking
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# ==========================================
# Node.js & React (Frontend in web/)
# ==========================================
web/node_modules/
web/dist/
web/build/
web/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
web/.eslintcache
web/dist-ssr/

# ==========================================
# Local Data & Docker Volumes
# ==========================================
# (In case you bind-mount volumes locally instead of using Docker named volumes)
postgres_data/
redis_data/
qdrant_data/
data/

# ==========================================
# Evaluations & Sandbox
# ==========================================
# Ignore large model generated reports, keep the folder structure
eval/reports/*
!eval/reports/.gitkeep

# Ignore temporary files created by the Sandbox runner
sandbox_tmp/
sandbox_workspace/

# ==========================================
# Logs & Tracing
# ==========================================
*.log
logs/
otel_traces/

# ==========================================
# OS & IDEs
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / PyCharm
.idea/
*.swp
*.swo