docker-compose.override.yml

# ==========================================
# Evaluations & sandbox
# ==========================================
# KEEP in git: eval/cache/ (cached model outputs so anyone can re-check the table)
# KEEP in git: eval/reports/results.md, ablation_table.md, failure_cases.csv
# IGNORE only the bulky raw run dumps:
eval/reports/raw/
eval/reports/*.tmp

# Temporary files created by the sandbox runner
sandbox_tmp/
sandbox_workspace/

